<!-- 企業一覧 -->
<div class="container px-5 px-sm-0">
  <div class="row">
    <div class="col-md-3">
      <%= render 'shared/profile_and_new_blog', user: current_user %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>口コミ一覧</h2>
      <table class="table">
        <tbody>
          <% @blogs.each do |blog| %>
            <tr>
              <td colspan="2">
                <%= blog.created_at.strftime("%Y-%m-%d") %>
                <%= blog.title %>
                <%= blog.user.name %>
              </td>
            </tr>

            <tr>
              <td><%= image_tag '蝶々.jpg', size: "100x100" %></td>

              <td>
                <p class="blog-body">
                  <%= truncate(blog.body, length: 45) %>
                  <% if blog.body.length > 45 %>
                    <%= link_to 'and more', blog_path(blog), class: "btn btn-sm btn-link" %>
                  <% end %>
                </p>

                <% if blog.post_image&.image&.attached? %>
                  <div class="imagecontainer">
                  <%= image_tag blog.post_image.image, style: "width: 70%;" %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= paginate @blogs %>
    </div>
  </div>
</div>
