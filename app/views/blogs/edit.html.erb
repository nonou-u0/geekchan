<h1>編集ぺーじ</h1>
<% if @blog.errors.any? %>
  <div id="error_explanation">
    <h2><%= @blog.errors.count %>errors prohibited this blog from being saved:</h2>
    <ul>
      <% @blog.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<!-- form_with部分 -->
<%= form_with model:@blog, local: true do |f| %>
  <div class="form-group">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.label :body, "本文" %>
    <%= f.text_area :body, class: "form-control" %>
  </div>

  <% if @blog.post_image&.image&.attached? %>
    <div class="mt-2 mb-2">
      <%= image_tag @blog.post_image.image, style: "max-width:600px;height:auto" %>
    </div>
  <% end %>

  <%= f.fields_for :post_image do |pf| %>
    <div class="form-group">
      <%= pf.file_field :image, accept: "image/*", class: "form-control" %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.submit '編集完了', class: "btn btn-successbtn btn-success" %>
  </div>
<% end %>

<div class="link-group">
  <%= link_to "戻る",  user_path(@user), class: "btn btn-warning" %>
</div>